# Supabase — crie um projeto dedicado a esta plataforma em https://supabase.com/dashboard
# Encontre estes valores em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave no navegador — só é lida em código server-side (route handlers, server actions)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada para gerar embeds e redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 — armazenamento dos arquivos de vídeo (Storage do Supabase
# fica só com thumbnails; o Free plan do Supabase limita upload a 50MB).
# Crie um bucket em https://dash.cloudflare.com > R2 Object Storage e um
# API Token com permissão "Object Read & Write" escopado a ele.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
